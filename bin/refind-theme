#!/usr/bin/env bash
# refind-theme: show or switch the rEFInd theme on the ESP.
#
#   refind-theme status            active theme, rotation mode and pool
#   refind-theme list              themes installed on the ESP (* = active)
#   refind-theme set <name>        make <name> active from the next boot
#   refind-theme next | random     step through / shuffle the rotation pool
#   refind-theme boot              what refind-theme-rotate.service runs each boot
#
# Rotation mode and pool come from rotation.conf on the ESP, which refind-esp-sync
# writes from the repo's src/config.json; change them in the configurator, not here.
# The active theme is whatever active-theme.conf (included by refind.conf) was
# composed from: themes/<name>/theme.conf plus entries.conf, with {theme} in icon
# paths replaced by <name>. Installed to /usr/local/bin by scripts/install-system.sh.
set -euo pipefail

REFIND_DIR=${REFIND_DIR:-/boot/EFI/refind}
STATE_DIR=${STATE_DIR:-/var/lib/refind-manager}
ACTIVE=$REFIND_DIR/active-theme.conf
MODE=off
THEMES=

die() { echo "refind-theme: $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "needs root to write the ESP; run with sudo"; }

installed() {
    local d
    for d in "$REFIND_DIR"/themes/*/; do
        [[ -f $d/theme.conf ]] && basename "$d"
    done
}

# The rotation pool: configured themes that are actually installed, else all installed.
pool() {
    local t all
    all=$(installed)
    for t in $THEMES; do grep -qxF -- "$t" <<<"$all" && echo "$t"; done | grep . || echo "$all"
}

current() {
    [[ -r $ACTIVE ]] || return 1
    sed -n 's/^# Active theme: \([^ ]*\).*/\1/p' "$ACTIVE" | head -n1
}

set_theme() {
    local name=$1 tmp=$ACTIVE.tmp
    need_root
    [[ -f $REFIND_DIR/themes/$name/theme.conf ]] || die "no such theme: $name (have: $(installed | tr '\n' ' '))"
    [[ -f $REFIND_DIR/entries.conf ]] || die "missing $REFIND_DIR/entries.conf; deploy first"
    {
        echo "# Active theme: $name"
        echo "# Written by refind-theme on $(date -Is). Do not edit."
        echo
        cat "$REFIND_DIR/themes/$name/theme.conf"
        echo
        sed "s/{theme}/$name/g" "$REFIND_DIR/entries.conf"
    } > "$tmp"
    mv -f "$tmp" "$ACTIVE"
    sync -f "$ACTIVE"
    if [[ -d $STATE_DIR ]]; then
        printf '%s\n' "$name" > "$STATE_DIR/active"
    fi
    echo "rEFInd theme: $name"
}

pick_next() {
    local cur all i
    cur=$(current || true)
    mapfile -t all < <(pool)
    for i in "${!all[@]}"; do
        if [[ ${all[$i]} == "$cur" ]]; then
            echo "${all[$(( (i + 1) % ${#all[@]} ))]}"
            return
        fi
    done
    echo "${all[0]}"
}

pick_random() {
    local cur others
    cur=$(current || true)
    mapfile -t others < <(pool | grep -vxF -- "$cur" || true)
    (( ${#others[@]} )) || { pick_next; return; }
    echo "${others[$(( RANDOM % ${#others[@]} ))]}"
}

[[ -d $REFIND_DIR ]] || die "$REFIND_DIR not found (is the ESP mounted?)"
if [[ -r $REFIND_DIR/rotation.conf ]]; then
    MODE=$(sed -n 's/^MODE=\([a-z]*\)$/\1/p' "$REFIND_DIR/rotation.conf")
    THEMES=$(sed -n 's/^THEMES=\([a-z0-9 -]*\)$/\1/p' "$REFIND_DIR/rotation.conf")
fi

case ${1:-} in
    status)
        echo "active:   $(current || echo none)"
        echo "rotation: ${MODE:-off}"
        echo "pool:     $(pool | tr '\n' ' ')"
        ;;
    list)
        cur=$(current || true)
        installed | while read -r t; do
            [[ $t == "$cur" ]] && echo "* $t" || echo "  $t"
        done
        ;;
    current) current || die "no active theme yet" ;;
    set)     [[ -n ${2:-} ]] || die "usage: refind-theme set <name>"; set_theme "$2" ;;
    next)    set_theme "$(pick_next)" ;;
    random)  set_theme "$(pick_random)" ;;
    boot)
        case $MODE in
            next)   set_theme "$(pick_next)" ;;
            random) set_theme "$(pick_random)" ;;
            *)      echo "rotation off; staying on $(current || echo none)" ;;
        esac
        ;;
    *)  sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
