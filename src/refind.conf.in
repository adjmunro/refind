# rEFInd configuration for magikarp.
#
# Generated by src/build.py from src/refind.conf.in + src/config.json; edit
# those in /data/repos/refind (github.com/adjmunro/refind), not this file.
# Changes made directly on the ESP are overwritten by the next deploy.
#
# Theme styling and the boot entries live in active-theme.conf, which
# `refind-theme` generates from themes/<name>/theme.conf + entries.conf.

timeout @TIMEOUT@
default_selection "@DEFAULT@"

# Native panel resolution; icons and backgrounds are drawn pixel-for-pixel for it.
resolution max
big_icon_size 128
small_icon_size 48

# Only the boot entries in entries.conf: no auto-detected kernels, fallback
# loaders, recovery partitions or duplicate shims.
scanfor manual

# Bottom row: power off, restart, reboot into firmware setup.
showtools shutdown,reboot,firmware

# Keep labels (the selected entry's name), hide the rest of the chrome.
hideui singleuser,hints,arrows,badges

# Must stay last so the theme can override anything above.
include active-theme.conf
