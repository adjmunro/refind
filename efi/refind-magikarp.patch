@@ -510,6 +512,53 @@
 } // VOID SetLinuxMatchPatterns()
 
 // read config file
+// theme_rotate <next|random> <file> <file>...  (magikarp patch)
+// Includes one of the files from refind.conf, picked once per launch: "next"
+// steps through them in order, "random" picks any but the last one shown. The
+// last pick is kept in the ThemeRotation variable, so every start of rEFInd
+// rotates, including restarts from its own menu. Once a file is picked, plain
+// `include` lines are skipped; a stock rEFInd ignores theme_rotate and uses them.
+static CHAR16 *RotatedFile = NULL;
+
+static CHAR16 *PickRotatedFile(CHAR16 **TokenList, UINTN TokenCount) {
+    UINTN     Count, Last = 0, Pick, Size = 0;
+    UINT64    Monotonic = 0;
+    UINT8     Stored;
+    CHAR8     *Buffer = NULL;
+    EFI_TIME  Now;
+
+    if ((RotatedFile != NULL) || (TokenCount < 3))
+        return RotatedFile;
+
+    Count = TokenCount - 2;
+    if ((EfivarGetRaw(&RefindGuid, L"ThemeRotation", &Buffer, &Size) == EFI_SUCCESS) &&
+        (Buffer != NULL) && (Size >= 1)) {
+        Last = (UINT8) Buffer[0];
+    }
+    MyFreePool(Buffer);
+
+    if (MyStriCmp(TokenList[1], L"random") && (Count > 1)) {
+        SetMem(&Now, sizeof(Now), 0);
+        refit_call2_wrapper(GetTime, &Now, NULL);
+        refit_call1_wrapper(BS->GetNextMonotonicCount, &Monotonic);
+        Pick = Now.Nanosecond ^ (Now.Second * 2654435761u) ^ (Now.Minute * 40503u) ^
+               (Now.Hour * 9973u) ^ (UINTN) (Monotonic >> 32) ^ (UINTN) Monotonic;
+        Pick = (Last + 1 + Pick % (Count - 1)) % Count;
+    } else {
+        Pick = (Last + 1) % Count;
+    }
+
+    if (!FileExists(SelfDir, TokenList[2 + Pick])) {
+        LOG(1, LOG_LINE_NORMAL, L"theme_rotate: '%s' is missing; using include", TokenList[2 + Pick]);
+        return NULL;
+    }
+    Stored = (UINT8) Pick;
+    EfivarSetRaw(&RefindGuid, L"ThemeRotation", (CHAR8 *) &Stored, 1, TRUE);
+    RotatedFile = StrDuplicate(TokenList[2 + Pick]);
+    LOG(1, LOG_LINE_NORMAL, L"theme_rotate: using '%s'", RotatedFile);
+    return RotatedFile;
+} // CHAR16 *PickRotatedFile()
