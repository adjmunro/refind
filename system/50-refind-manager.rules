// Installed by the refind repo's scripts/install-system.sh.
// Lets @OWNER@ start refind-esp-sync.service, which copies the built boot-menu
// config from the repo onto the ESP, without a password. Nothing else.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "refind-esp-sync.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "@OWNER@") {
        return polkit.Result.YES;
    }
});
