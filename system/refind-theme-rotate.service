[Unit]
Description=Rotate the rEFInd theme for the next boot (mode set in rotation.conf on the ESP)
Documentation=https://github.com/adjmunro/refind
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=/usr/local/bin/refind-theme boot
StateDirectory=refind-manager

[Install]
WantedBy=multi-user.target
